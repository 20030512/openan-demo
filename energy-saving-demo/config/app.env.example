# Energy-Saving Agent + Save Strategy: settings of the server.
# The server reads config/app.env, made from this file on the first ./start.sh.
# Change settings with ./start.sh NAME=value ... (they are saved here; on a running system ./start.sh stop first). One NAME=value per
# line, no quotes.
#
# WHAT THE DEPLOYING DEVELOPER MUST SET before the first ./start.sh (the server starts without them, but every request that needs a missing one fails
# and the log says which; ./start.sh help shows the commands):
#   1. the LLM:      LLM_PROVIDER, LLM_MODEL, LLM_API_KEY (and LLM_BASE_URL for a model inside the network)   [required]
#   2. the database: DB_PATH, only when the file must not live in the install folder                          [optional]
#   3. the Network Agent: MAE_BASE_URL, MAE_USERNAME, MAE_PASSWORD (no default: ask the owner of the Network Agent)            [required]
# Everything else can stay as it is. Full steps: README.md

# =====================================================================================================================
# 1. LLM (REQUIRED): the model that reads the dialog sentences and the task parameters
# =====================================================================================================================
# A model from a provider on the internet:   LLM_PROVIDER = deepseek | openrouter | groq | gemini | xai
#   ./start.sh check-llm LLM_PROVIDER=deepseek LLM_MODEL=deepseek-v4-flash LLM_API_KEY=sk-...
# A model inside the customer network (any server that speaks the OpenAI chat API, http or https, name or IP address):
#   ./start.sh check-llm LLM_BASE_URL=http://192.0.2.5:8080/v1
#   (the address is enough: the first model the server lists is used; add LLM_MODEL and LLM_API_KEY only if that server needs them.
#   The app calls <LLM_BASE_URL>/chat/completions, with "Authorization: Bearer <key>" when a key is set.)
# (check-llm saves the settings and asks the model once, without starting anything; then ./start.sh starts it)
LLM_ENABLED=true
# Not needed: it follows from LLM_BASE_URL (empty: deepseek; the address of a known provider: that provider; any other address, such as a
# model inside the network: "custom", which needs no key and no model name).
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# low, medium or high: the model thinks before it answers (slower). Empty: it answers at once.
LLM_REASONING_EFFORT=
# Optional, for models with their own rules: a number, or empty for the built-in value (temperature 0, answer limit 300; 4000 with an effort).
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
# Seconds the app waits for the model's answer; empty: 300 (5 minutes). A fast server needs far less, e.g. 30.
LLM_TIMEOUT_SECONDS=
# The prompts and limits of the AI steps.
LLM_CONFIG_FILE=config/llm.config.json

# =====================================================================================================================
# 2. Database (SQLite file; both apps use this one file)
# =====================================================================================================================
# The one database file. The package ships it, empty, in the install folder; relative paths start at the install folder.
#   ./start.sh DB_PATH=/data/energy-saving/energy.db      (a folder that exists or can be made, writable by this user)
# An update takes the data along (./start.sh update <old folder>). Back it up with ./start.sh backup.
DB_PATH=data/energy.db

# =====================================================================================================================
# 3. Network Agent
# =====================================================================================================================
# The Network Agent that receives the tasks: its address and the login of the server. The server logs in at start and writes the result
# to its log (INFO when it works, ERROR with the cause when it does not).
# There is no default: ask the owner of the Network Agent. Set the three values once:
#   ./start.sh MAE_BASE_URL=http://<host>:<port> MAE_USERNAME=<user> MAE_PASSWORD=<password>
MAE_BASE_URL=
MAE_USERNAME=
MAE_PASSWORD=
# How long a connection to the real Network Agent may take before it counts as "no answer", in milliseconds.
# Test the settings without starting: ./start.sh check-mae (it says apart: wrong address, nothing listens, no answer, wrong login).
MAE_TIMEOUT_MS=8000
# The certificate of an https Network Agent is checked. A Network Agent with a certificate of its own (self-signed, or from an authority
# this machine does not know) needs it as a PEM file here. Only if that is not possible, MAE_TLS_VERIFY=false switches the check off
# (a warning is logged at every start).
MAE_CA_FILE=
MAE_TLS_VERIFY=true

# =====================================================================================================================
# Web, logs, admin: normally left as they are
# =====================================================================================================================
# One port for both apps: http://<host>:<PORT>/dashboard/ and http://<host>:<PORT>/strategy/
PORT=8000
HOST=0.0.0.0
# Level: debug (every step: LLM prompt/answer, Task-T text, MAE request; only while testing, it writes the sentences of the users), info, warn or error.
LOG_LEVEL=info
# pretty = lines for reading; json = one JSON object per line, for log tools.
LOG_FORMAT=pretty
NODE_ENV=production
# Key for the LLM settings API (/api/admin/llm). Empty: that API is switched off (the safe default).
ADMIN_KEY=
